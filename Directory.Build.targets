<Project>
  <!--
    This is a special file that contains shared configuration
    for all project files in subdirectories.
  -->

  <Sdk Name="ThunderPipe.Sdk" Version="0.1.3" />

  <PropertyGroup>
    <!-- Set additional NuGet sources -->
    <RestoreAdditionalProjectSources>
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.windows10ce.com/nuget/v3/index.json
    </RestoreAdditionalProjectSources>
    <!--
      Conditions for ThunderPipe.Sdk to Pack, and Publish to Thunderstore
      Learn more: https://github.com/WarperSan/ThunderPipe/blob/master/ThunderPipe.Sdk/README.md
    -->
    <RunThunderPipePackAfterBuild
      Condition="'$(RunThunderPipePackAfterBuild)' != 'false' And '$(IsThunderstorePackable)' == 'true' And '$(Configuration)' == 'Release'"
      >true</RunThunderPipePackAfterBuild
    >
    <RunThunderPipePublishAfterBuild
      Condition="'$(RunThunderPipePublishAfterBuild)' != 'false' And '$(RunThunderPipePackAfterBuild)' == 'true' And '$(PublishTS)' == 'true'"
      >true</RunThunderPipePublishAfterBuild
    >
  </PropertyGroup>

  <!-- Build dependencies -->
  <ItemGroup>
    <!--
      If you upload your project on NuGet, PrivateAssets="all"
      prevents consumers of your package from referencing these
      packages transitively. This is desired because these packages
      are not required by anyone using your package as they are
      code analyzers, source generators, or other build-only packages.
    -->
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <PackageReference Include="Hamunii.BepInEx.AutoPlugin" Version="2.1.*" PrivateAssets="all" />
    <!-- Source-only polyfills for C# language features https://github.com/Sergio0694/PolySharp -->
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Modding dependencies -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <!-- In reality BepInEx 5.4.21 ships HarmonyX 2.9 but BepInEx.Core gives us 2.7 -->
    <PackageReference Include="HarmonyX" Version="2.9.0" />
  </ItemGroup>

  <!-- NuGet fallback stripped game references -->
  <ItemGroup Condition="!Exists('$(ManagedDir)')">
    <PackageReference Include="UnityEngine.Modules" Version="6000.0.36" PrivateAssets="all" />
  </ItemGroup>

  <!-- Local game references -->
  <ItemGroup Condition="Exists('$(ManagedDir)')">
    <!--
      Reference all assemblies except ones that come
      with our target framework or would cause conflicts.
      Private="false" prevents these from being copied to build output.
    -->
    <LocalReferences
      Include="$(ManagedDir)*.dll"
      Exclude="$(ManagedDir)Mono*.dll;$(ManagedDir)netstandard.dll;$(ManagedDir)System*.dll;$(ManagedDir)mscorlib.dll"
    />
    <Reference Include="@(LocalReferences)" Private="false" />
    <!--
      Publicize these assemblies so we can access their internal members.
      Learn more at: https://github.com/BepInEx/BepInEx.AssemblyPublicizer
    -->
    <Reference Include="$(ManagedDir)Assembly-CSharp.dll" Private="false" Publicize="true" />
  </ItemGroup>

  <!-- Copy mod files defined in projects to the target BepInEx directory -->
  <Target Name="DeployFiles" AfterTargets="Build" Condition="'$(DeployModFiles)' == 'true'">
    <PropertyGroup>
      <_TargetDir>$([MSBuild]::NormalizeDirectory($(PEAKBepInExDir)))</_TargetDir>
    </PropertyGroup>
    <Message
      Text="Deploy → @(ModFile -> '%(Destination)%(FileName)%(Extension)')"
      Importance="High"
    />
    <Error
      Text="BepInEx directory '$(_TargetDir)' doesn't exist! Configure PEAKBepInExDir to point to a valid path in the Config.Build.user.props file."
      Condition="!Exists('$(_TargetDir)')"
    />
    <Copy SourceFiles="@(ModFile)" DestinationFolder="$(_TargetDir)%(Destination)" />
  </Target>

  <Target Name="MapModFilesForThunderPipe" AfterTargets="Build" BeforeTargets="ThunderPipePack">
    <ItemGroup>
      <ThunderstoreFile Include="@(ModFile)" />
    </ItemGroup>
  </Target>

  <Target
    Name="EnsureReleaseOnPublishTS"
    BeforeTargets="ThunderPipePublish"
    Condition="'$(RunThunderPipePublishAfterBuild)' == 'true' And '$(Configuration)' != 'Release'"
  >
    <Error Text="Release configuration must be used when publishing Thunderstore package." />
  </Target>

  <Target
    Name="LanRelease"
    DependsOnTargets="Build"
  >
    <PropertyGroup>
      <LanReleaseOutputDir Condition="'$(LanReleaseOutputDir)' == ''">$(SolutionRoot)artifacts/release</LanReleaseOutputDir>
      <LanReleasePackageId Condition="'$(LanReleasePackageId)' == ''">BadHorse.PeakLanMod</LanReleasePackageId>
      <_LanReleaseName>$(LanReleasePackageId)-LAN-v$(Version)</_LanReleaseName>
      <_LanReleaseRoot>$([MSBuild]::NormalizeDirectory('$(LanReleaseOutputDir)'))</_LanReleaseRoot>
      <_LanReleaseStageDir>$(_LanReleaseRoot)$(_LanReleaseName)\</_LanReleaseStageDir>
      <_LanReleaseZipPath>$(_LanReleaseRoot)$(_LanReleaseName).zip</_LanReleaseZipPath>
      <_LanReleaseExternalRoot Condition="'$(LanReleaseCopyOutputDir)' != ''">$([MSBuild]::NormalizeDirectory('$(LanReleaseCopyOutputDir)'))</_LanReleaseExternalRoot>
      <_LanReleaseExternalZipPath Condition="'$(LanReleaseCopyOutputDir)' != ''">$(_LanReleaseExternalRoot)$(_LanReleaseName).zip</_LanReleaseExternalZipPath>
      <_LanReleaseChecksumPath>$(_LanReleaseStageDir)metadata\CHECKSUMS.sha256</_LanReleaseChecksumPath>
      <_LanReleaseBuildInfoPath>$(_LanReleaseStageDir)metadata\BUILD_INFO.txt</_LanReleaseBuildInfoPath>
      <_LanReleaseInstallGuide>$(SolutionRoot)release\INSTALL-LAN.md</_LanReleaseInstallGuide>
      <_LanReleaseDependenciesGuide>$(SolutionRoot)release\DEPENDENCIES-README.md</_LanReleaseDependenciesGuide>
      <_LanReleaseServerDir>$(SolutionRoot)server\</_LanReleaseServerDir>
      <_LanReleasePdbPath>$(TargetDir)$(AssemblyName).pdb</_LanReleasePdbPath>
    </PropertyGroup>

    <ItemGroup>
      <_LanReleaseRequiredFile Include="$(TargetPath)" />
      <_LanReleaseRequiredFile Include="$(_LanReleaseInstallGuide)" />
      <_LanReleaseRequiredFile Include="$(_LanReleaseDependenciesGuide)" />
      <_LanReleaseRequiredFile Include="$(_LanReleaseServerDir)luxon_server.msvc.release.exe" />
      <_LanReleaseRequiredFile Include="$(_LanReleaseServerDir)config.example.yml" />
    </ItemGroup>

    <Error
      Text="LanRelease missing required file: %(_LanReleaseRequiredFile.Identity)"
      Condition="!Exists('%(_LanReleaseRequiredFile.Identity)')"
    />

    <MakeDir Directories="$(_LanReleaseRoot)" />
    <MakeDir Directories="$(_LanReleaseExternalRoot)" Condition="'$(_LanReleaseExternalRoot)' != ''" />
    <RemoveDir Directories="$(_LanReleaseStageDir)" Condition="Exists('$(_LanReleaseStageDir)')" />
    <Delete Files="$(_LanReleaseZipPath)" Condition="Exists('$(_LanReleaseZipPath)')" />
    <Delete Files="$(_LanReleaseExternalZipPath)" Condition="'$(_LanReleaseExternalZipPath)' != '' And Exists('$(_LanReleaseExternalZipPath)')" />

    <MakeDir Directories="$(_LanReleaseStageDir)mod\BepInEx\plugins" />
    <MakeDir Directories="$(_LanReleaseStageDir)mod\BepInEx\config" />
    <MakeDir Directories="$(_LanReleaseStageDir)server" />
    <MakeDir Directories="$(_LanReleaseStageDir)dependencies" />
    <MakeDir Directories="$(_LanReleaseStageDir)docs" />
    <MakeDir Directories="$(_LanReleaseStageDir)metadata" />

    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFiles="$(_LanReleaseStageDir)mod\BepInEx\plugins\$(AssemblyName).dll"
    />

    <Copy
      SourceFiles="$(_LanReleasePdbPath)"
      DestinationFiles="$(_LanReleaseStageDir)mod\BepInEx\plugins\$(AssemblyName).pdb"
      Condition="Exists('$(_LanReleasePdbPath)')"
    />

    <Copy
      SourceFiles="$(_LanReleaseDependenciesGuide)"
      DestinationFiles="$(_LanReleaseStageDir)dependencies\README.md"
    />

    <Copy
      SourceFiles="$(_LanReleaseInstallGuide)"
      DestinationFiles="$(_LanReleaseStageDir)docs\INSTALL-LAN.md"
    />

    <Copy
      SourceFiles="$(_LanReleaseInstallGuide)"
      DestinationFiles="$(_LanReleaseStageDir)README.md"
    />

    <Copy
      SourceFiles="$(SolutionRoot)CHANGELOG.md"
      DestinationFiles="$(_LanReleaseStageDir)CHANGELOG.md"
      Condition="Exists('$(SolutionRoot)CHANGELOG.md')"
    />

    <Copy
      SourceFiles="$(_LanReleaseServerDir)luxon_server.msvc.release.exe"
      DestinationFiles="$(_LanReleaseStageDir)server\luxon_server.msvc.release.exe"
    />

    <Copy
      SourceFiles="$(_LanReleaseServerDir)config.example.yml"
      DestinationFiles="$(_LanReleaseStageDir)server\config.yml"
    />

    <WriteLinesToFile
      File="$(_LanReleaseBuildInfoPath)"
      Overwrite="true"
      Lines="Version: $(Version);Configuration: $(Configuration);BuiltAtUtc: $([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'));GitCommit: $(SourceRevisionId);Project: $(MSBuildProjectName)"
    />

    <Exec
      Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-ChildItem -File -Recurse '$(_LanReleaseStageDir)' | Where-Object { $_.FullName -notmatch 'CHECKSUMS\\.sha256$' } | Get-FileHash -Algorithm SHA256 | ForEach-Object { '{0}  {1}' -f $_.Hash.ToLowerInvariant(), ($_.Path.Substring('$(_LanReleaseStageDir)'.Length).Replace('\\','/')) } | Set-Content '$(_LanReleaseChecksumPath)'&quot;"
    />

    <ZipDirectory
      SourceDirectory="$(_LanReleaseStageDir)"
      DestinationFile="$(_LanReleaseZipPath)"
      Overwrite="true"
    />

    <Copy
      SourceFiles="$(_LanReleaseZipPath)"
      DestinationFiles="$(_LanReleaseExternalZipPath)"
      Condition="'$(_LanReleaseExternalZipPath)' != ''"
    />

    <Message
      Text="LanRelease complete: stage=$(_LanReleaseStageDir); zip=$(_LanReleaseZipPath)"
      Importance="High"
    />

    <Message
      Text="LanRelease copied zip to external output: $(_LanReleaseExternalZipPath)"
      Importance="High"
      Condition="'$(_LanReleaseExternalZipPath)' != ''"
    />
  </Target>
</Project>
