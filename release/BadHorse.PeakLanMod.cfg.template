## PEAK LAN Mod config template for LAN package releases
## Copy this file into BepInEx/config/BadHorse.PeakLanMod.cfg

[Direct Connect]

## Enable the experimental direct-connect flow.
# Setting type: Boolean
# Default value: true
Enabled = true

## Photon room name.
# Setting type: String
# Default value: antonwahlberg-test-room
RoomName = awg-lan-room-1

## Photon Cloud region.
# Setting type: String
# Default value: eu
Region =

## Start direct host.
# Setting type: KeyboardShortcut
# Default value: F6
HostKey = F6

## Start direct join.
# Setting type: KeyboardShortcut
# Default value: F7
JoinKey = F7

[Photon]

## Photon endpoint mode: CustomCloud (legacy) or LocalServer.
# Setting type: PhotonConnectionMode
# Default value: CustomCloud
# Acceptable values: CustomCloud, LocalServer
Mode = LocalServer

## Custom Photon PUN application ID.
# Setting type: String
# Default value:
AppIdRealtime =

## Custom Photon Voice application ID.
# Setting type: String
# Default value:
AppIdVoice =

## Local server bootstrap endpoint fallback used before discovery selection.
## In M6 discovery UI flow this is usually auto-managed by host auto-detect and join-selected actions.
# Setting type: String
# Default value: 127.0.0.1
LocalServerAddress = 127.0.0.1

## Local Photon Server UDP/TCP port.
# Setting type: Int32
# Default value: 5055
LocalServerPort = 5058

## Photon transport protocol for local server mode.
# Setting type: ConnectionProtocol
# Default value: Udp
# Acceptable values: Udp, Tcp, WebSocket, WebSocketSecure
LocalServerProtocol = Udp

[LanWorkflow]

## Auto-detect host LAN IPv4 during direct host in LocalServer mode.
# Setting type: Boolean
# Default value: false
AutoDetectHostIPv4 = false

## Optional manual host LAN IPv4 override. When set, this value is used instead of interface auto-detection.
# Setting type: String
# Default value:
PreferredHostIPv4 =

## Optional CSV interface filters (name/description/id contains match) for host LAN IPv4 auto-detection.
# Setting type: String
# Default value:
AllowedHostInterfaces =

## Automatically rewrite Luxon external_address values during direct host in LocalServer mode.
# Setting type: Boolean
# Default value: false
AutoUpdateLuxonConfigOnHost = false

## Relative or absolute path to Luxon config.yml used by host-side external_address automation.
# Setting type: String
# Default value: server/config.yml
LuxonConfigPath = server/config.yml

## Start local server executable during direct host when no matching process is already running.
# Setting type: Boolean
# Default value: false
AutoStartLocalServerOnHost = false

## Relative or absolute path to the local server executable for optional host auto-start.
# Setting type: String
# Default value: server/luxon_server.msvc.release.exe
LocalServerExecutablePath = server/luxon_server.msvc.release.exe

## Working directory used when launching the local server executable.
# Setting type: String
# Default value:
LocalServerWorkingDirectory =

## Arguments passed to the local server executable when host auto-start is enabled.
# Setting type: String
# Default value: config.yml
LocalServerStartArguments = config.yml

## Stop only plugin-owned local server process on plugin unload/game exit.
# Setting type: Boolean
# Default value: true
AutoStopOwnedLocalServerOnExit = true

## Force-kill plugin-owned local server process on exit when graceful stop times out.
# Setting type: Boolean
# Default value: true
ForceKillOwnedLocalServerOnExit = true

## Timeout in milliseconds for graceful stop of plugin-owned local server process.
# Setting type: Int32
# Default value: 2000
OwnedLocalServerStopTimeoutMs = 2000

## Queue host intent on HostKey and auto-complete when Photon becomes connected and ready.
# Setting type: Boolean
# Default value: true
AutoRetryDirectHostUntilReady = true

## Wait for local NameServer readiness before direct host/join connect attempts in LocalServer mode.
# Setting type: Boolean
# Default value: false
EnableLocalServerReadinessCheck = false

## Maximum milliseconds to wait for local NameServer readiness before connect attempts.
# Setting type: Int32
# Default value: 5000
ReadinessTimeoutMs = 5000

## Milliseconds between local NameServer readiness probe attempts.
# Setting type: Int32
# Default value: 250
ReadinessPollIntervalMs = 250

## Enable UDP LAN session discovery listener and host announcement broadcast in LocalServer mode.
# Setting type: Boolean
# Default value: false
DiscoveryEnabled = false

## UDP port used for LAN discovery announcements.
# Setting type: Int32
# Default value: 47777
DiscoveryUdpPort = 47777

## Interval in milliseconds for host discovery announcements.
# Setting type: Int32
# Default value: 1000
DiscoveryBroadcastIntervalMs = 1000

## Milliseconds before an unrefreshed discovered session is evicted.
# Setting type: Int32
# Default value: 5000
DiscoveryEntryTtlMs = 5000

## Discovery protocol version string advertised and required for session compatibility.
# Setting type: String
# Default value: 1
ProtocolVersion = 1

## Require exact game/mod version match for discovery session compatibility.
# Setting type: Boolean
# Default value: true
RequireVersionMatch = true

## Enable M6 LAN UI actions and discovered-session overlay in LocalServer mode.
# Setting type: Boolean
# Default value: false
EnableLanUiActions = false

## Maximum discovered sessions rendered in M6 overlay.
# Setting type: Int32
# Default value: 6
LanUiOverlayMaxSessions = 6
